            for(int j=0; j<arr[i].length; j++){
                arr[i][j]=sc.nextInt();
            }
        }
        int sum=0;
        for(int i=0; i<arr.length;i++){
            for(int j=0; j<arr[i].length; j++){
                if(i==j){
                  sum+=arr[i][j];
                  
                }
            }
        }
        int secsum=0,diff=0;
           for(int i=0; i<arr.length;i++){
            for(int j=0; j<arr[i].length; j++){
                if(i+j==N-1){
                    secsum+=arr[i][j];
                }
    }
}
            diff=Math.abs(sum-secsum);
            System.out.print(diff);
    }
}
