import java.util.Scanner;
public class Main{
    public static void main(String [] args){
        Scanner sc= new Scanner(System.in);
        System.out.println("enter k value");
        int k=sc.nextInt();
        System.out.println("enter the array elements");
        int[] arr= new int[6];
        int n=arr.length;
        for(int i=0; i<arr.length; i++){
            arr[i]=sc.nextInt();
        }
        int right=0,left=0;
        int sum=0,rightcount=0;
        int maxsum=0;
        while(right<arr.length){
            if(rightcount<k){
              sum+=arr[right];
              rightcount++;
              right++;
            }
            else{
                break;
            }
            if(maxsum<sum){
                maxsum=sum;
            }
            sum=0;
                left++;
                right=left;
                rightcount=0;
            
        }
        System.out.println(maxsum);
    }
}
